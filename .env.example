# Copy this file to .env and fill in real values. Never commit .env.

# Required: your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Flask session signing key. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a dev-only insecure default is used.
SECRET_KEY=change_me_to_a_random_string

# Optional: OpenAI chat model used by all features (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Enable the Flask debugger and auto-reload (never enable in production)
FLASK_DEBUG=false

# Optional: full path to the tesseract executable, if it is not on your PATH
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
